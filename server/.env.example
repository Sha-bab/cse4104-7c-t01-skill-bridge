# Server configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (replace <username>, <password>, and <cluster-url>)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/skillbridge?retryWrites=true&w=majority

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# JWT authentication secrets (use long random strings in production)
JWT_SECRET=replace_with_a_long_random_access_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Email OTP configuration (optional in development; logs OTP to server console if omitted)
OTP_EXPIRES_MINUTES=10
EMAIL_FROM=Skill Bridge <no-reply@skillbridge.local>
RESEND_API_KEY=

# AI & Vector Search configuration (optional in development; uses safe fallback when omitted)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
ATLAS_VECTOR_INDEX=note_chunks_vector_index
